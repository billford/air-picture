# Copy to .env and fill in values
ANTHROPIC_API_KEY=sk-ant-...

# Optional: push notification via ntfy.sh (free, no account needed)
# Visit https://ntfy.sh and pick any topic name
NTFY_TOPIC=

# Optional: Facebook page posting
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# Optional: email the full report over SMTP (any provider).
# Cloudflare Email Sending: host smtp.mx.cloudflare.net, port 465,
# user "api_token", pass = API token with "Email Sending: Edit".
EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Site deploy auth where `wrangler login` is not an option (lola). Token needs
# only Account > Cloudflare Pages > Edit.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
